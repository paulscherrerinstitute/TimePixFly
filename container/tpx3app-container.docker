# Stage 1: Build Stage
FROM ubuntu:24.04 AS builder

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Define the branch/tag as an argument (defaulting to master)
ARG REPO_BRANCH=dev

# Install build dependencies for Ubuntu
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libpoco-dev \
    libjemalloc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir build && cd build \
    && git clone --branch ${REPO_BRANCH} --single-branch https://github.com/paulscherrerinstitute/TimePixFly.git . \
    && chmod +x compile.sh && AVX_DECODE=1 ./compile.sh

# Stage 2: Final Runtime Stage
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install only the necessary runtime shared libraries
RUN apt-get update && apt-get install -y \
    libpoco-dev \
    libjemalloc-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder
COPY --from=builder /build/tpx3app /app/tpx3app

ENTRYPOINT ["./tpx3app"]
